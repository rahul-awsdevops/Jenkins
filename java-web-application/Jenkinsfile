pipeline {
    agent any

    tools {
        maven 'Maven'  // This should match the Maven name set in "Global Tool Configuration"
    }

    stages {
        stage('Build') {
            steps {
                dir('java-web-application') {  // Change to correct directory
                    sh 'mvn clean package'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('java-web-application') {  // Ensure SonarQube runs in correct directory
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def qg = waitForQualityGate()
                    if (qg.status != 'OK') {
                        error "Quality Gate failed: ${qg.status}"
                    }
                }
            }
        }
    }
}
