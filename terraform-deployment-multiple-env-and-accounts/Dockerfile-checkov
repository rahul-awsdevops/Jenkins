# Use the official Jenkins Inbound Agent image as the base image
FROM jenkins/inbound-agent:latest

# Switch to root user to install dependencies
USER root

# Set environment variables
ENV TERRAFORM_VERSION=1.5.5
ENV PATH="/root/.local/bin:$PATH"

# Install dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    jq     \
    python3 \
    python3-pip \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*
# Install Checkov in a way that avoids system package conflicts
RUN pip install --break-system-packages checkov

# Ensure the user PATH includes the local bin directory
RUN echo 'export PATH=$HOME/.local/bin:$PATH' >> /etc/profile

# Add Docker’s official GPG key
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg

# Add the Docker APT repository (for Debian 12 "bookworm")
RUN echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bookworm stable" \
    | tee /etc/apt/sources.list.d/docker.list > /dev/null

# Update package lists and install Docker
RUN apt-get update && apt-get install -y \
    docker-ce \
    docker-ce-cli \
    containerd.io

# Add Jenkins user to the Docker group (so it can run Docker)
RUN usermod -aG docker jenkins 

# Install AWS CLI
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws

# Install Terraform
RUN curl -LO "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
    && unzip "terraform_${TERRAFORM_VERSION}_linux_amd64.zip" -d /usr/local/bin \
    && rm -f "terraform_${TERRAFORM_VERSION}_linux_amd64.zip"

# Verify installations
RUN aws --version \
    && terraform --version \
    && docker --version \
    && git --version

# Switch back to the jenkins user
USER jenkins

# Default command to run when the container starts (already set in the base image)
# CMD ["jenkins-agent"]